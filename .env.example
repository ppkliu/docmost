# Production runs NODE_ENV=production, so DB migrations run automatically on boot
# (no manual migration step needed). Dev (.env.dev) does not — see DEV_AUTO_MIGRATE there.
#
# Production host port the app is published on. The app container always listens on 3000.
APP_HOST_PORT=3010
# your public domain, e.g https://example.com (use APP_HOST_PORT for local docker)
APP_URL=http://localhost:${APP_HOST_PORT}
# system display name (branding); blank falls back to "Docmost"
APP_NAME=IEIT WIKI

# Production app image (used by docker-compose.prod.yml + start.sh).
# 取得順序:本地已有 → docker pull → 用 Dockerfile build。請設成你「實際擁有」的 tag。
#   官方映像(無自訂程式時最省事,會自動 pull):   DOCMOST_IMAGE=docmost/docmost:latest
#   自行打包/載入的映像(對齊 docker images 的 tag): DOCMOST_IMAGE=agentwiki-docmost:1.0.0
# 注意:tag 要和 `docker images` 顯示的一致,否則 start.sh 會找不到而嘗試 build。
DOCMOST_IMAGE=agentwiki-docmost:1.0.0


# minimum of 32 characters. Generate one with: openssl rand -hex 32
APP_SECRET=REPLACE_WITH_LONG_SECRET

JWT_TOKEN_EXPIRES_IN=30d

# Production host port Postgres is published on. The db container always listens on 5432.
POSTGRES_HOST_PORT=15434
# Production host port Valkey/Redis is published on. The valkey container always listens on 6379.
REDIS_HOST_PORT=26378
POSTGRES_USER=docmost
POSTGRES_DB=docmost
# Database password (used by both postgres and DATABASE_URL)
POSTGRES_PASSWORD=REPLACE_WITH_DB_PASSWORD

# In docker compose the host is the service name "db" (not localhost)
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=public"
# In docker compose the host is the service name "valkey" (not 127.0.0.1)
REDIS_URL=redis://valkey:6379

# options: local | s3 | azure
STORAGE_DRIVER=local

# S3 driver config
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=

# Azure Blob Storage driver config
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=

# default: 50mb
FILE_UPLOAD_SIZE_LIMIT=50mb

# options: smtp | postmark
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Docmost

# SMTP driver config
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_IGNORETLS=false

# Postmark driver config
POSTMARK_TOKEN=

# for custom drawio server
DRAWIO_URL=

# Gotenberg URL for server-side PDF export
GOTENBERG_URL=

# AI provider config for a local / self-hosted OpenAI-compatible API
# Use the LAN / VPN IP when the model server runs on another machine.
# If the model server runs on the Docker host, host.docker.internal points to it.
# Supported drivers: openai | openai-compatible | gemini | ollama
# AI_DRIVER=openai-compatible
# OPENAI_API_URL=http://192.168.1.100:1234/v1
# OPENAI_API_KEY=local-api-key
# AI_COMPLETION_MODEL=local-model-name

# Optional: enables AI Search and the AI Chat workspace search tool.
# Embeddings use the same OPENAI_API_URL above; this app does not have a separate
# embedding base URL env var.
# AI_EMBEDDING_MODEL=local-embedding-model-name
# AI_EMBEDDING_DIMENSION=1536

# Common local alternatives:
# OPENAI_API_URL=http://192.168.1.100:1234/v1            # model server on LAN
# OPENAI_API_URL=http://host.docker.internal:8000/v1      # localai / vllm / llama.cpp server
# OPENAI_API_URL=http://host.docker.internal:11434/v1     # ollama OpenAI-compatible endpoint
# AI_DRIVER=openai              # uses OPENAI_API_KEY; OPENAI_API_URL is optional
# AI_DRIVER=gemini              # requires GEMINI_API_KEY
# GEMINI_API_KEY=
# AI_DRIVER=ollama              # requires OLLAMA_API_URL
# OLLAMA_API_URL=http://host.docker.internal:11434/api

DISABLE_TELEMETRY=false

# Allow other sites to embed Docmost in an iframe.
IFRAME_EMBED_ALLOWED=false

# Only used when IFRAME_EMBED_ALLOWED=true. When empty, any origin is allowed.
# Example: https://intranet.example.com,https://portal.example.com
IFRAME_ALLOWED_ORIGINS=

# Enable debug logging in production (default: false)
DEBUG_MODE=false

# Log database queries
DEBUG_DB=false

# Log http requests
LOG_HTTP=false

# Network-origin permission layer for page/attachment sensitive output.
# Existing user/page/space permissions are still checked first.
# Policy is zone-based (design v2): resources uploaded/created from the internal
# zone can only be exported/downloaded from the internal zone; resources from the
# office zone can be reached from either zone. See docs/design/docmost-network-origin-permissions-design.md.
DOCMOST_INTERNAL_CIDRS=100.0.0.0/8
DOCMOST_OFFICE_CIDRS=
# Zone stamped on native Docmost username/password logins (WUJI SSO logins are
# stamped separately by wuji-adapter, unaffected by this var). Defaults to
# "office" to match the common case (native login = office-network account).
# Set to "internal" on deployments used for internal-network test cases
# (e.g. an internal-only test server) so that pages/attachments uploaded via
# native login there are correctly scoped "internal" instead of "office" --
# otherwise they get treated as office-origin and become downloadable from
# any office-zone session, defeating the internal/office isolation test.
# Values: office | internal
DOCMOST_NATIVE_LOGIN_ZONE=office
# Optional static fallback for deployments that are permanently one zone.
# Leave empty for normal session-based behavior:
# native Docmost login => DOCMOST_NATIVE_LOGIN_ZONE; WUJI SSO => wuji-adapter WUJI_HOST IP/CIDRs.
DOCMOST_DEPLOYMENT_ZONE=
DOCMOST_ORIGIN_NETWORK_MASK_V4=24
DOCMOST_ORIGIN_NETWORK_MASK_V6=64
DOCMOST_UNKNOWN_ORIGIN_POLICY=allow
TRUST_PROXY=false
# Set true only once the dual-entrance Caddy setup (wuji-adapter/deploy/Caddyfile,
# X-Docmost-Entrance header) is actually deployed — an absent header is then
# treated as suspicious (unknown zone) instead of silently falling back to CIDR-only.
DOCMOST_ENTRANCE_HEADER_REQUIRED=false

# Fixed editor toolbar shown above the editor by default. Users can still
# turn it off per-account in Preferences. Set to false to default it OFF.
EDITOR_TOOLBAR_DEFAULT=true
