# Copy this file to .env.dev and run dev compose with:
# docker compose --env-file .env.dev -f docker-compose.dev.yml up

# Dev host port the app API/server is published on. The app container always listens on 3000.
DEV_APP_HOST_PORT=3011
# Dev host port the Vite frontend is published on. The client container always listens on 5173.
DEV_CLIENT_HOST_PORT=5173
APP_URL=http://localhost:${DEV_APP_HOST_PORT}

# Dev only: NODE_ENV=development does NOT auto-run DB migrations (only production does),
# so a fresh dev DB has no tables and the app errors with relation "workspaces" does not exist.
# start.sh dev runs "migration:latest" once after startup when this is true.
# Set to false to skip it and migrate manually.
DEV_AUTO_MIGRATE=true


# minimum of 32 characters. Generate one with: openssl rand -hex 32
APP_SECRET=REPLACE_WITH_LONG_SECRET

JWT_TOKEN_EXPIRES_IN=30d

# Dev host port Postgres is published on. The db container always listens on 5432.
DEV_POSTGRES_HOST_PORT=25433
# Dev host port Valkey/Redis is published on. The valkey container always listens on 6379.
DEV_REDIS_HOST_PORT=26379
POSTGRES_USER=docmost
POSTGRES_DB=docmost
# Database password (used by both postgres and DATABASE_URL)
POSTGRES_PASSWORD=REPLACE_WITH_DB_PASSWORD

# In docker compose the host is the service name "db" (not localhost)
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=public"
# In docker compose the host is the service name "valkey" (not 127.0.0.1)
REDIS_URL=redis://valkey:6379

# options: local | s3 | azure
STORAGE_DRIVER=local

# S3 driver config
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=

# Azure Blob Storage driver config
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=

# default: 50mb
# 單一檔案上傳上限。未設定或留空 = 200mb（與 FILE_IMPORT_SIZE_LIMIT 一致）。
# ★ 前面的反向代理必須放行**略高於**這個值：multipart 的框架開銷會讓一個
#   200mb 的檔案變成大於 200mb 的請求。nginx 建議 client_max_body_size 220m
#   （nginx 的預設只有 1m，不改的話使用者會收到 413）。
# ★ 這個值也該與 kb-stack 的 KB_MAX_ATTACHMENT_MB 對齊。比它高的部分會形成
#   一段靜默落差：檔案傳得上來、wiki 上看得到，但永遠不會進知識庫。
FILE_UPLOAD_SIZE_LIMIT=200mb

# options: smtp | postmark
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Docmost

# SMTP driver config
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_IGNORETLS=false

# Postmark driver config
POSTMARK_TOKEN=

# for custom drawio server
DRAWIO_URL=

# Gotenberg URL for server-side PDF export
GOTENBERG_URL=

# AI provider config for a local / self-hosted OpenAI-compatible API
# Use the LAN / VPN IP when the model server runs on another machine.
# If the model server runs on the Docker host, host.docker.internal points to it.
# Supported drivers: openai | openai-compatible | gemini | ollama
# AI_DRIVER=openai-compatible
# OPENAI_API_URL=http://192.168.1.100:1234/v1
# OPENAI_API_KEY=local-api-key
# AI_COMPLETION_MODEL=local-model-name

# Optional: enables AI Search and the AI Chat workspace search tool.
# Embeddings use the same OPENAI_API_URL above; this app does not have a separate
# embedding base URL env var.
# AI_EMBEDDING_MODEL=local-embedding-model-name
# AI_EMBEDDING_DIMENSION=1536

# Common local alternatives:
# OPENAI_API_URL=http://192.168.1.100:1234/v1            # model server on LAN
# OPENAI_API_URL=http://host.docker.internal:8000/v1      # localai / vllm / llama.cpp server
# OPENAI_API_URL=http://host.docker.internal:11434/v1     # ollama OpenAI-compatible endpoint
# AI_DRIVER=openai              # uses OPENAI_API_KEY; OPENAI_API_URL is optional
# AI_DRIVER=gemini              # requires GEMINI_API_KEY
# GEMINI_API_KEY=
# AI_DRIVER=ollama              # requires OLLAMA_API_URL
# OLLAMA_API_URL=http://host.docker.internal:11434/api

DISABLE_TELEMETRY=false

# Allow other sites to embed Docmost in an iframe.
IFRAME_EMBED_ALLOWED=false

# Only used when IFRAME_EMBED_ALLOWED=true. When empty, any origin is allowed.
# Example: https://intranet.example.com,https://portal.example.com
IFRAME_ALLOWED_ORIGINS=

# Enable debug logging in production (default: false)
DEBUG_MODE=true

# Log database queries
DEBUG_DB=true

# Log http requests
LOG_HTTP=true

# Network-origin permission layer for page/attachment sensitive output.
# Native Docmost login is always office/external. WUJI SSO zone is stamped by wuji-adapter.
WUJI_INTERNAL_IPS=100.19.8.25
DOCMOST_INTERNAL_CIDRS=100.0.0.0/8
DOCMOST_OFFICE_CIDRS=
DOCMOST_DEPLOYMENT_ZONE=
DOCMOST_ORIGIN_NETWORK_MASK_V4=24
DOCMOST_ORIGIN_NETWORK_MASK_V6=64
DOCMOST_UNKNOWN_ORIGIN_POLICY=allow
TRUST_PROXY=false
DOCMOST_ENTRANCE_HEADER_REQUIRED=false
